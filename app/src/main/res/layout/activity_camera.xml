<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Viewfinder -->
    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="52dp">

        <com.sushil.scenecam.AutoFitTextureView
            android:id="@+id/texture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.sushil.scenecam.GridOverlay
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.sushil.scenecam.MatchPreviewView
            android:id="@+id/flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#000000" />

        <TextView
            android:id="@+id/tipBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/pill_dark"
            android:lineSpacingExtra="2dp"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:textColor="#F2F4F7"
            android:textSize="12.5sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/pill_dark"
            android:fontFamily="monospace"
            android:paddingLeft="14dp"
            android:paddingTop="5dp"
            android:paddingRight="14dp"
            android:paddingBottom="5dp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#000000"
            android:shadowRadius="12"
            android:textColor="#FFFFFF"
            android:textSize="110sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp">

        <ImageView
            android:id="@+id/scenesBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="All scenes"
            android:padding="10dp"
            android:src="@drawable/ic_scenes" />

        <LinearLayout
            android:id="@+id/titleBox"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginLeft="6dp"
                android:alpha="0.8"
                android:src="@drawable/ic_info" />
        </LinearLayout>

        <TextView
            android:id="@+id/timerBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="#FFB547"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/gridBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Grid"
            android:padding="10dp"
            android:src="@drawable/ic_grid" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_fade"
        android:orientation="vertical"
        android:paddingTop="22dp"
        android:paddingBottom="20dp">

        <!-- Zoom -->
        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/pill_dark"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingLeft="3dp"
            android:paddingRight="3dp" />

        <!-- Pro settings strip -->
        <LinearLayout
            android:id="@+id/proStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="12dp"
            android:orientation="horizontal" />

        <!-- EV slider (opens from the EV cell) -->
        <LinearLayout
            android:id="@+id/evPanel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <SeekBar
                android:id="@+id/evSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/evReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/pill_dark"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="RESET"
                android:textColor="#FFB547"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scene bar -->
        <HorizontalScrollView
            android:id="@+id/carouselScroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:fadingEdgeLength="40dp"
            android:overScrollMode="never"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/carousel"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Photo / Video -->
        <LinearLayout
            android:id="@+id/modeSeg"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@drawable/segment_bg"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="PHOTO"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="VIDEO"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Gallery, shutter, flip -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/thumb"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_vertical|left"
                android:layout_marginLeft="36dp"
                android:background="@drawable/thumb_ring"
                android:contentDescription="Last shot"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/shutter"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter_photo"
                android:contentDescription="Shutter" />

            <ImageView
                android:id="@+id/flip"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_gravity="center_vertical|right"
                android:layout_marginRight="36dp"
                android:background="@drawable/circle_btn"
                android:contentDescription="Switch camera"
                android:padding="14dp"
                android:src="@drawable/ic_flip" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
